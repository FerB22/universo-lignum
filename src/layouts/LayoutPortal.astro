---
import HeaderNavegacion from '../components/HeaderNavegacion.astro';
import FooterUniverso from '../components/FooterUniverso.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = "Universo Lignum | Monorepositorio Literario", description = "Explora el multiverso literario con scoped CSS e historias unificadas." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>
  <HeaderNavegacion tituloActual="Portal Principal" subtituloActual="Multiverso Lignum" colorTema="#38BDF8" />

  <main class="portal-main">
    <slot />
  </main>

  <FooterUniverso />
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    background: #090B10;
    color: #F8FAFC;
    font-family: 'Plus Jakarta Sans', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }
</style>
