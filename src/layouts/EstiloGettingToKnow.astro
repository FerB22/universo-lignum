---
import HeaderNavegacion from '../components/HeaderNavegacion.astro';
import FooterUniverso from '../components/FooterUniverso.astro';

export interface Props {
  tituloCapitulo?: string;
}

const { tituloCapitulo = "Getting to Know" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tituloCapitulo} | Getting to Know - Universo Lignum</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
</head>
<body class="cyberpunk-layout-body">
  <HeaderNavegacion tituloActual="Getting to Know" subtituloActual="Estilo Cyberpunk #00F2FE & Púrpura" colorTema="#00F2FE" />

  <div class="cyberpunk-universe-wrapper">
    <slot />
  </div>

  <FooterUniverso />
</body>
</html>

<!-- Scoped CSS Strategy for Getting to Know Universe -->
<style scoped>
  .cyberpunk-layout-body {
    background-color: #070913 !important;
    color: #E0F7FA !important;
    font-family: 'Rajdhani', sans-serif !important;
  }

  .cyberpunk-universe-wrapper {
    max-width: 1100px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: #0B0E1B;
    border-radius: 16px;
    border: 2px solid #00F2FE;
    box-shadow: 0 0 35px rgba(0, 242, 254, 0.3), inset 0 0 15px rgba(155, 81, 224, 0.2);
  }

  :global(.cyberpunk-universe-wrapper h1) {
    font-family: 'Orbitron', sans-serif;
    color: #00F2FE;
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #9B51E0;
    padding-bottom: 0.85rem;
    text-shadow: 0 0 12px #00F2FE, 0 0 25px #9B51E0;
  }

  :global(.cyberpunk-universe-wrapper p) {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #C7D2FE;
    margin-bottom: 1.25rem;
  }
</style>
