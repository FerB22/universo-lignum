---
import HeaderNavegacion from '../components/HeaderNavegacion.astro';
import FooterUniverso from '../components/FooterUniverso.astro';

export interface Props {
  tituloCapitulo?: string;
}

const { tituloCapitulo = "The Marriage of the Republic" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tituloCapitulo} | The Marriage of the Republic - Universo Lignum</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;1,400&family=Plus+Jakarta+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body class="republic-layout-body">
  <HeaderNavegacion tituloActual="The Marriage of the Republic" subtituloActual="Estilo Marrón Claro #8B5A2B & Dorado" colorTema="#8B5A2B" />

  <div class="republic-universe-wrapper">
    <slot />
  </div>

  <FooterUniverso />
</body>
</html>

<!-- Scoped CSS Strategy for The Marriage of the Republic Universe -->
<style scoped>
  .republic-layout-body {
    background-color: #FDFBF7 !important;
    color: #4A3525 !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
  }

  .republic-universe-wrapper {
    max-width: 1100px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: #FFFDF9;
    border-radius: 18px;
    border: 2px solid #8B5A2B;
    box-shadow: 0 12px 35px rgba(139, 90, 43, 0.12);
  }

  :global(.republic-universe-wrapper h1) {
    font-family: 'Playfair Display', serif;
    color: #8B5A2B;
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #D4AF37;
    padding-bottom: 0.85rem;
  }

  :global(.republic-universe-wrapper p) {
    font-size: 1.08rem;
    line-height: 1.85;
    color: #3D2B1F;
    margin-bottom: 1.2rem;
  }
</style>
