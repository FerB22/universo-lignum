---
import HeaderNavegacion from '../components/HeaderNavegacion.astro';
import FooterUniverso from '../components/FooterUniverso.astro';

export interface Props {
  tituloCapitulo?: string;
}

const { tituloCapitulo = "Forgotten Sword" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tituloCapitulo} | Forgotten Sword - Universo Lignum</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Cinzel:wght@700&family=UnifrakturMaguntia&family=Inter:wght@400;600&display=swap" rel="stylesheet">
</head>
<body class="forgotten-layout-body">
  <HeaderNavegacion tituloActual="Forgotten Sword" subtituloActual="Estilo Gótico & Plata Oscura" colorTema="#8B0000" />

  <div class="forgotten-universe-wrapper">
    <slot />
  </div>

  <FooterUniverso />
</body>
</html>

<!-- Scoped CSS Strategy for Forgotten Sword Universe -->
<style scoped>
  .forgotten-layout-body {
    background-color: #0B0B0E !important;
    color: #E2E8F0 !important;
    font-family: 'Inter', sans-serif !important;
  }

  .forgotten-universe-wrapper {
    max-width: 1100px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: #13131A;
    border-radius: 16px;
    border: 1px solid rgba(139, 0, 0, 0.4);
    box-shadow: 0 0 30px rgba(139, 0, 0, 0.25), inset 0 0 15px rgba(0, 0, 0, 0.8);
  }

  :global(.forgotten-universe-wrapper h1) {
    font-family: 'Cinzel Decorative', 'Cinzel', serif;
    color: #E2E8F0;
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #8B0000;
    padding-bottom: 1rem;
    text-shadow: 0 0 10px rgba(139, 0, 0, 0.6);
  }

  :global(.forgotten-universe-wrapper p) {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #CBD5E1;
    margin-bottom: 1.2rem;
  }
</style>
