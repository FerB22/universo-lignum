---
import HeaderNavegacion from '../components/HeaderNavegacion.astro';
import FooterUniverso from '../components/FooterUniverso.astro';

export interface Props {
  tituloCapitulo?: string;
}

const { tituloCapitulo = "Sangre y Cadáveres" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tituloCapitulo} | Sangre y Cadáveres - Universo Lignum</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Cinzel:wght@700;900&family=Plus+Jakarta+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body class="sangre-layout-body">
  <HeaderNavegacion tituloActual="Sangre y Cadáveres" subtituloActual="Estilo Escarlata #CA0B0B & Negro Vaciado" colorTema="#CA0B0B" />

  <div class="sangre-universe-wrapper">
    <slot />
  </div>

  <FooterUniverso />
</body>
</html>

<!-- Scoped CSS Strategy for Sangre y Cadáveres Universe -->
<style scoped>
  .sangre-layout-body {
    background-color: #0D0202 !important;
    color: #F8FAFC !important;
    font-family: 'Plus Jakarta Sans', sans-serif !important;
  }

  .sangre-universe-wrapper {
    max-width: 1100px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: #140404;
    border-radius: 16px;
    border: 2px solid #CA0B0B;
    box-shadow: 0 0 40px rgba(202, 11, 11, 0.35);
  }

  :global(.sangre-universe-wrapper h1) {
    font-family: 'Cinzel', serif;
    color: #FF3333;
    text-align: center;
    font-size: 2.3rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #CA0B0B;
    padding-bottom: 1rem;
    text-shadow: 0 0 15px rgba(202, 11, 11, 0.8);
  }

  :global(.sangre-universe-wrapper p) {
    font-size: 1.08rem;
    line-height: 1.85;
    color: #E2E8F0;
    margin-bottom: 1.25rem;
  }
</style>
