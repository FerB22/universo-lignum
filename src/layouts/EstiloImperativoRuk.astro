---
import HeaderNavegacion from '../components/HeaderNavegacion.astro';
import FooterUniverso from '../components/FooterUniverso.astro';

export interface Props {
  tituloCapitulo?: string;
}

const { tituloCapitulo = "Ruk el Héroe" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{tituloCapitulo} | Ruk el Héroe - Universo Lignum</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Lora:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body class="ruk-layout-body">
  <HeaderNavegacion tituloActual="Ruk el Héroe" subtituloActual="Estilo Blanco & Dorado Imperial" colorTema="#D4AF37" />

  <div class="ruk-universe-wrapper">
    <slot />
  </div>

  <FooterUniverso />
</body>
</html>

<!-- Scoped CSS Strategy for Ruk el Héroe Universe -->
<style scoped>
  .ruk-layout-body {
    background-color: #FAF8F5 !important;
    color: #2C261F !important;
    font-family: 'Lora', serif !important;
  }

  .ruk-universe-wrapper {
    max-width: 1100px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: #FFFFFF;
    border-radius: 20px;
    border: 2px solid #D4AF37;
    box-shadow: 0 15px 40px rgba(212, 175, 55, 0.15);
  }

  :global(.ruk-universe-wrapper h1),
  :global(.ruk-universe-wrapper h2),
  :global(.ruk-universe-wrapper h3) {
    font-family: 'Cinzel', serif;
    color: #2C261F;
    letter-spacing: 1px;
  }

  :global(.ruk-universe-wrapper h1) {
    border-bottom: 2px solid #FFD700;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    text-align: center;
    color: #9E8237;
  }

  :global(.ruk-universe-wrapper p) {
    font-size: 1.1rem;
    line-height: 1.85;
    margin-bottom: 1.25rem;
    color: #3A3228;
  }
</style>
