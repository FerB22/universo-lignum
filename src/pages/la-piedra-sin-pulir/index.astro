---
import EstiloLaPiedraSinPulir from '../../layouts/EstiloLaPiedraSinPulir.astro';
---

<EstiloLaPiedraSinPulir tituloCapitulo="La Piedra sin Pulir">
  <article class="emerald-contenido">
    <div class="emerald-header">
      <span class="emerald-badge">🌿 FÁBULA MÍSTICA 🌿</span>
      <h1>LA PIEDRA SIN PULIR</h1>
      <p class="emerald-subtitle">Transformación interior y alquimia en verde esmeralda (#10B981).</p>
    </div>

    <section class="emerald-lectura">
      <p>
        El caminante se detuvo junto a la cantera de granito. Observó la piedra bruta sin labrar y comprendió que el esculpido de la propia alma requiere la paciencia de las montañas...
      </p>
    </section>
  </article>
</EstiloLaPiedraSinPulir>
