---
import EstiloForgottenSword from '../../layouts/EstiloForgottenSword.astro';
---

<EstiloForgottenSword tituloCapitulo="Forgotten Sword - Fantasía Gótica">
  <article class="forgotten-contenido">
    <div class="gothic-header">
      <span class="gothic-badge">⚔ EDICIÓN GÓTICA ⚔</span>
      <h1>FORGOTTEN SWORD</h1>
      <p class="gothic-subtitle">Leyendas olvidadas en la penumbra del acero rúnico y la sangre anciana.</p>
    </div>

    <div class="fichas-grid">
      <div class="ficha-card">
        <h3>Alianzas Góticas</h3>
        <p>Los antiguos caballeros de la orden de plata custodiaron las catacumbas antes de la caída.</p>
      </div>
      <div class="ficha-card">
        <h3>El Acero Olvidado</h3>
        <p>Una hoja forjada con mineral estelar que absorbe las almas de quienes caen en batalla.</p>
      </div>
    </div>
  </article>
</EstiloForgottenSword>
