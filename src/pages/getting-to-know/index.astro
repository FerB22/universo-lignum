---
import EstiloGettingToKnow from '../../layouts/EstiloGettingToKnow.astro';
---

<EstiloGettingToKnow tituloCapitulo="Getting to Know - Cyberpunk">
  <article class="cyberpunk-contenido">
    <div class="cyberpunk-header">
      <span class="cyber-badge">⚡ CYBERPUNK NEÓN ⚡</span>
      <h1>GETTING TO KNOW</h1>
      <p class="cyber-subtitle">Fichas de personajes cibernéticos y redes neuronales en turquesa (#00F2FE).</p>
    </div>

    <div class="character-cards-grid">
      <div class="cyber-card">
        <h3>Amera</h3>
        <p>Especialista en intrusión de redes de datos y hackeo subcortical.</p>
      </div>
      <div class="cyber-card">
        <h3>Derk</h3>
        <p>Mercenario modificado con implantes cinéticos y armadura de carbono.</p>
      </div>
    </div>
  </article>
</EstiloGettingToKnow>
