---
export interface Props {
  titulo: string;
  genero: string;
  descripcion: string;
  ruta: string;
  etiquetaColor: string;
  badge: string;
  capitulos: number;
  estiloNombre: string;
  iconSvg?: string;
}

const { titulo, genero, descripcion, ruta, etiquetaColor, badge, capitulos, estiloNombre } = Astro.props;
---

<div class="tarjeta-historia" style={`--accent-card: ${etiquetaColor};`}>
  <div class="card-glass">
    <div class="card-header">
      <span class="badge-genero">{genero}</span>
      <span class="badge-layout">{estiloNombre}</span>
    </div>

    <h3 class="card-title">{titulo}</h3>
    <p class="card-desc">{descripcion}</p>

    <div class="card-meta">
      <span class="meta-item">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
        {capitulos} Capítulos
      </span>
      <span class="meta-status">{badge}</span>
    </div>

    <div class="card-footer">
      <a href={ruta} class="btn-leer">
        <span>Leer Historia</span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style scoped>
  .tarjeta-historia {
    position: relative;
    border-radius: 16px;
    background: rgba(22, 27, 38, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tarjeta-historia:hover {
    transform: translateY(-6px);
    border-color: var(--accent-card);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 255, 255, 0.05);
  }

  .card-glass {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    gap: 0.5rem;
  }

  .badge-genero {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--accent-card);
    border: 1px solid var(--accent-card);
  }

  .badge-layout {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.5);
    font-family: monospace;
  }

  .card-title {
    font-family: 'Cinzel', serif, sans-serif;
    font-size: 1.4rem;
    color: #FFF;
    margin-bottom: 0.65rem;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.9rem;
    color: #94A3B8;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 1.25rem;
    font-size: 0.8rem;
    color: #64748B;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-status {
    color: #10B981;
    font-weight: 600;
  }

  .card-footer {
    display: flex;
  }

  .btn-leer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.75rem;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #FFF;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-leer:hover {
    background: var(--accent-card);
    border-color: var(--accent-card);
    color: #000;
  }
</style>
